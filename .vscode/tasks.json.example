{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Libryo: Build dev",
      "type": "shell",
      "command": "yarn dev",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Libryo: Run tests",
      "type": "shell",
      "command": "php artisan test",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
